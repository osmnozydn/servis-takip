{
  "expo": {
    "name": "Servis Takip",
    "slug": "servis-takip",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.servistakip.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.servistakip.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "servistakip",
    "plugins": [
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Servis aracının konumunu yolculara iletebilmek için uygulama arka plandayken de konumunuza erişmesi gerekir.",
          "locationWhenInUsePermission": "Servis aracının konumunu yolculara iletebilmek için konumunuza erişmemiz gerekir.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ]
    ]
  }
}